<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- WebK: permite http solo en loopback para el servidor local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Tor: http://*.onion sale por el proxy SOCKS (cifrado en el
             circuito); Android lo frenaba antes de llegar (CLEARTEXT). -->
        <domain includeSubdomains="true">onion</domain>
    </domain-config>
</network-security-config>
